      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://blackbox-server-d557.onrender.com"
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://blackbox-server-d557.onrender.com"
      }
    }
  },
  "submit": { "production": {} }
}
